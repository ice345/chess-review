worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  # Do not log query strings, cookies, IPs, or OAuth authorization codes.
  log_format safe '$time_iso8601 $request_method $uri $status $request_time';
  access_log /dev/stdout safe;
  # The ONLY published socket is host loopback, reached by existing cloudflared.
  # All local users / Docker peers are trusted. Never publish this on 0.0.0.0.
  set_real_ip_from 0.0.0.0/0;
  set_real_ip_from ::/0;
  real_ip_header CF-Connecting-IP;
  real_ip_recursive off;
  limit_req_zone $binary_remote_addr zone=per_client:1m rate=4r/s;
  limit_req_zone $server_name zone=all_clients:1m rate=10r/s;
  limit_conn_zone $binary_remote_addr zone=connections:1m;
  limit_req_status 429;
  limit_conn_status 429;
  client_max_body_size 64k;
  client_body_timeout 10s;
  client_header_timeout 10s;
  keepalive_timeout 30s;
  resolver 127.0.0.11 valid=5s ipv6=off;
  server { listen 8080 default_server; server_name _; return 421; }
  server {
    listen 8080;
    server_name __DOMAIN__;
    if ($http_x_forwarded_proto = "http") { return 308 https://__DOMAIN__$request_uri; }
    limit_conn connections 32;
    error_page 429 = @limited;
    location @limited {
      default_type application/json;
      add_header Cache-Control no-store always;
      add_header Retry-After 60 always;
      return 429 '{"error":"Too many requests. Please retry shortly."}';
    }
    # Cache-Control headers are set by the application (next.config.ts) and
    # passed through unchanged: /sw.js sends no-cache, /engine/* and /sounds/*
    # send immutable. No proxy_cache is configured, so Nginx never stores
    # responses. The Cloudflare edge MUST be configured to bypass cache for
    # HTML and /sw.js — see README § 4 for required Cache Rules.
    location / {
      set $app http://web:3000;
      proxy_pass $app;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host __DOMAIN__;
      proxy_set_header X-Forwarded-Host __DOMAIN__;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_buffering off;
      proxy_connect_timeout 5s;
      proxy_read_timeout 35s;
      proxy_send_timeout 15s;
    }
    location /api/ {
      limit_req zone=per_client burst=20 nodelay;
      limit_req zone=all_clients burst=40 nodelay;
      set $app http://web:3000;
      proxy_pass $app;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host __DOMAIN__;
      proxy_set_header X-Forwarded-Host __DOMAIN__;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_buffering off;
      proxy_connect_timeout 5s;
      proxy_read_timeout 35s;
      proxy_send_timeout 15s;
    }
  }
}
