{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Chess Review Mobile",
  "version": "0.1.0",
  "identifier": "org.openchessreview.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Chess Review Mobile",
        "width": 430,
        "height": 860,
        "minWidth": 320,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../desktop/src-tauri/icons/icon.png"]
  }
}
