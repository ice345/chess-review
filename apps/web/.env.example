# Production builds default to browser-core; no localhost probes or hosted AI.
# Development on localhost defaults to enhanced-local. Set explicitly to test either mode.
# NEXT_PUBLIC_APP_MODE=browser-core
# Enhanced Local only, using a local loopback service:
# NEXT_PUBLIC_LOCAL_AI_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_LOCAL_AI_TOKEN is a local launcher handshake, never a public service secret.
# Public Browser Core builds reject it. API provider keys belong in services/local-ai.

# Server-only canonical origin. Required for Lichess sign-in on a public deployment.
# APP_ORIGIN=https://your-real-domain.example
# Public OAuth client identifier. Choose a unique hostname or app ID.
# LICHESS_CLIENT_ID=your-real-domain.example
# Private server-only key for encrypted HttpOnly OAuth session cookies.
# Generate locally with: openssl rand -base64 32
# LICHESS_SESSION_SECRET=your-private-random-key-at-least-24-characters

# Rate limits always apply per server process. All unknown clients share a bucket.
# Set this ONLY if a trusted ingress overwrites that exact header with one IP
# and direct access to the app is blocked. Never trust user-supplied X-Forwarded-For.
# PLATFORM_CLIENT_IP_HEADER=x-real-ip
# Multiple instances/serverless require additional shared ingress limits; see docs/web-service-boundaries.md.

# Only behind an ingress that overwrites Host/X-Forwarded-Host/Proto and blocks Node-port bypass.
# deploy/nuc sets this automatically; leave unset for direct local development.
TRUST_PROXY_ORIGIN=
