# ---------------------------------------------------------------------------
# Dependencies and interpreters
# ---------------------------------------------------------------------------
node_modules/
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Build output - every entry below is regenerated by a documented command
# ---------------------------------------------------------------------------
.next/
# Next rewrites this per command: `next dev` records `.next/dev/types/...` and
# `next build` records `.next/types/...`. `apps/web` typechecks with
# `next typegen && tsc` and CI typechecks before it builds, so this file is
# generated output, never source.
next-env.d.ts
dist/
target/
services/local-ai/build/
apps/desktop/src-tauri/binaries/
**/src-tauri/gen/schemas/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
coverage/
playwright-report/
blob-report/
test-results/

# ---------------------------------------------------------------------------
# Tool caches and stray logs
# ---------------------------------------------------------------------------
.turbo/
.vercel/
.eslintcache
*.log

# ---------------------------------------------------------------------------
# Vite (apps/desktop, apps/mobile) local overrides and config bundling temp files
# ---------------------------------------------------------------------------
*.local
vite.config.*.timestamp-*

# ---------------------------------------------------------------------------
# Secrets - only the checked-in examples are tracked
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example

# ---------------------------------------------------------------------------
# Editors and operating system
# ---------------------------------------------------------------------------
.DS_Store
._*
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# ---------------------------------------------------------------------------
# One package manager only (pnpm). Do not let another one add a lockfile.
# ---------------------------------------------------------------------------
package-lock.json
yarn.lock

# ---------------------------------------------------------------------------
# Upstream repositories are research material, not production source.
# `.gitkeep` keeps the empty directory in a fresh clone.
# ---------------------------------------------------------------------------
references/*
!references/.gitkeep

# ---------------------------------------------------------------------------
# Local browser inspection artifacts are not product source or test baselines.
# ---------------------------------------------------------------------------
.playwright-mcp/
page-screenshot.png
.tmp-ui-pass/
.home-shots/
.ocr-live-audit/
/tmp/

# ---------------------------------------------------------------------------
# Local agent-harness session state (model roles, locks); never product source.
# `.claude/` is tracked on purpose: it carries the shared skills and rules.
# ---------------------------------------------------------------------------
/.omp/

# ---------------------------------------------------------------------------
# One-off local capture/diagnostic tooling. Not product source, and several
# hardcode an absolute developer path.
# ---------------------------------------------------------------------------
/scripts/cabinet-library-shots.mjs
/scripts/capture-*.mjs
/scripts/diag-*.mjs
/scripts/inspect-idb-keys.mjs
/scripts/probe-*.mjs
/scripts/seed-and-capture-*.mjs
/scripts/verify-kickers.mjs
/apps/web/scripts/
/make-ui-review-bundle-local.sh
